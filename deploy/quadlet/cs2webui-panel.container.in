[Unit]
Description=CS2 WebUI panel
After=network-online.target
Wants=network-online.target
After=cs2webui-agent.service

[Container]
Image=localhost/cs2webui:local
ContainerName=cs2webui-panel
PublishPort=__WEBUI_PORT__:8000
Volume=__DATA_DIR__:/data:z
Environment=CS2WEBUI_DATA_DIR=/data/panel
Environment=CS2WEBUI_SECURE_COOKIES=__SECURE_COOKIES__

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
